{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",

"logo": {
  // Glowing sword image (kitty graphics). Other terminals fall back automatically.
  "type": "kitty-direct",
  "source": "~/.config/fastfetch/sword.png",
  "width": 31,
  "height": 26,
  "padding": {
	"top": 1,
	"left": 2,
	"right": 3
	}
},

  // Cut off long lines instead of wrapping them onto the logo in narrow windows
  "display": { "disableLinewrap": true },

  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "display",
    "de",
    "wm",
    "wmtheme",
    // Just the GTK theme (the stock line also lists a long GTK2 leftover and wraps in half-width windows)
    { "type": "command", "key": "Theme", "text": "gsettings get org.gnome.desktop.interface gtk-theme | tr -d \"'\"" },
    "icons",
    "font",
    "cursor",
    "terminal",
    "terminalfont",
    "cpu",
    "gpu",
    "memory",
    "swap",
    "disk",
    "localip",
    "battery",
    "poweradapter",
    "locale",
    "break",
    "colors"
  ]
}
