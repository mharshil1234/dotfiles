
env = XDG_CURRENT_DESKTOP,Hyprland
env = XDG_SESSION_DESKTOP,Hyprland

env = QT_QPA_PLATFORMTHEME,qt6ct
env = GTK_THEME,Breeze-Dark

env = XCURSOR_THEME,BreezeX-Dark
env = XCURSOR_SIZE,24

exec-once = sh -c "sleep 1 && waybar"

# Workspace 1
exec-once = sh -c "sleep 2 && hyprctl dispatch workspace 1"

# Terminal LEFT
exec-once = [workspace 1 silent] sh -c "sleep 2.5 && kitty sh -c 'fastfetch; exec bash'"

# Spotify RIGHT
exec-once = [workspace 1 silent] sh -c "sleep 4 && spotify-launcher"

# Small cava visualizer
exec-once = [workspace 1 silent] sh -c "sleep 5 && kitty --class cava -o initial_window_width=1200 -o initial_window_height=180 -e cava"

exec-once = nm-applet --indicator

exec-once = swaync

exec-once = blueman-applet

exec-once = dunst

exec-once = /usr/lib/polkit-kde-authentication-agent-1

exec-once = swww-daemon
exec-once = swww img ~/Pictures/Wallpapers/lighthouse.png

# Open Chrome on workspace 2 at startup
exec-once = [workspace 2 silent] google-chrome-stable

monitor=,preferred,auto,1

general {
    gaps_in = 2
    gaps_out = 10
    border_size = 0
    layout = dwindle
}

decoration {
    rounding = 12

    blur {
        enabled = true
        size = 6
        passes = 2
    }
}

animations {
    enabled = true
}

input {
    kb_layout = us
    follow_mouse = 1

    touchpad {

        natural_scroll = true
	scroll_factor = 0.3
    }

}

gestures {
    gesture = 3, horizontal, workspace
}


bind = SUPER, left, movefocus, l
bind = SUPER, right, movefocus, r
bind = SUPER, up, movefocus, u
bind = SUPER, down, movefocus, d
bind = SUPER, P, pseudo
bind = SUPER, V, togglefloating
bind = SUPER, F, fullscreen

bind = SUPER SHIFT, left, movewindow, l
bind = SUPER SHIFT, right, movewindow, r
bind = SUPER SHIFT, up, movewindow, u
bind = SUPER SHIFT, down, movewindow, d

binde = , XF86AudioRaiseVolume, exec, wpctl set-volume @DEFAULT_AUDIO_SINK@ 1%+
binde = , XF86AudioLowerVolume, exec, wpctl set-volume @DEFAULT_AUDIO_SINK@ 1%-
binde = , XF86AudioMute, exec, wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle

bind = , XF86MonBrightnessUp, exec, brightnessctl s +20%
bind = , XF86MonBrightnessDown, exec, brightnessctl s 20%-

bind = SUPER, 1, workspace, 1
bind = SUPER, 2, workspace, 2
bind = SUPER, 3, workspace, 3
bind = SUPER, 4, workspace, 4
bind = SUPER, 5, workspace, 5
bind = SUPER, 6, workspace, 6
bind = SUPER, 7, workspace, 7
bind = SUPER, 8, workspace, 8
bind = SUPER, 9, workspace, 9

bind = SUPER SHIFT, 1, movetoworkspace, 1
bind = SUPER SHIFT, 2, movetoworkspace, 2
bind = SUPER SHIFT, 3, movetoworkspace, 3
bind = SUPER SHIFT, 4, movetoworkspace, 4
bind = SUPER SHIFT, 5, movetoworkspace, 5

bind = CTRL, Print, exec, grim ~/Pictures/screenshot-$(date +%s).png

bind = SUPER, Print, exec, grim -g "$(slurp)" ~/Pictures/screenshot-$(date +%s).png

bind = , Print, exec, grim -g "$(slurp)" - | wl-copy

bind = SUPER, L, exec, hyprlock

# This config is a STUB! This should never be generated.
# Use the default lua config from https://github.com/hyprwm/Hyprland/blob/main/example/hyprland.lua



$mainMod = SUPER
$terminal = kitty
$fileManager = dolphin
$menu = rofi -show drun

bind = SUPER, Q, exec, $terminal
bind = SUPER, C, killactive,
bind = SUPER, M, exec, command -v hyprshutdown >/dev/null 2>&1 && hyprshutdown || hyprctl dispatch exit
bind = SUPER, E, exec, $fileManager
bind = SUPER, V, togglefloating,
bind = SUPER, R, exec, $menu

#windowrule = opacity 0.94 0.94, class:^(dolphin)$
#windowrule = opacity 0.96 0.96, class:^(kitty)$
