background {
    path = screenshot
    blur_passes = 3
    blur_size = 8
}

input-field {
    size = 250, 50
    position = 0, -80

    dots_center = true
    fade_on_empty = false
    rounding = 12

    font_color = rgb(ffffff)
    inner_color = rgb(1e1e2e)
    outer_color = rgb(89b4fa)

    placeholder_text = Password...
}

label {
    text = cmd[update:1000] echo "$(date +"%H:%M")"

    font_size = 64
    position = 0, 80

    color = rgb(ffffff)
}
